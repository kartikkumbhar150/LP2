import java.util.*;

class Node implements Comparable<Node> {
    int[][] state;
    int x, y;
    int g, h;
    Node parent;

    Node(int[][] state, int x, int y, int g, int h, Node parent) {
        this.state = state;
        this.x = x;
        this.y = y;
        this.g = g;
        this.h = h;
        this.parent = parent;
    }

    int f() {
        return g + h;
    }

    public int compareTo(Node other) {
        return this.f() - other.f();
    }
}

public class AStar8Puzzle {

    static int[][] goal = {
            {1, 2, 3},
            {4, 5, 6},
            {7, 8, 0}
    };

    static int[] dx = {-1, 1, 0, 0};
    static int[] dy = {0, 0, -1, 1};

    static int heuristic(int[][] state) {
        int count = 0;

        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                if (state[i][j] != 0 && state[i][j] != goal[i][j]) {
                    count++;
                }
            }
        }

        return count;
    }

    static String matrixToString(int[][] mat) {
        StringBuilder sb = new StringBuilder();

        for (int[] row : mat) {
            for (int val : row) {
                sb.append(val);
            }
        }

        return sb.toString();
    }

    static void printPath(Node node) {
        if (node == null)
            return;

        printPath(node.parent);

        for (int[] row : node.state) {
            for (int val : row) {
                System.out.print(val + " ");
            }
            System.out.println();
        }

        System.out.println();
    }

    public static void solve(int[][] start, int x, int y) {

        PriorityQueue<Node> pq = new PriorityQueue<>();
        Set<String> visited = new HashSet<>();

        Node root = new Node(start, x, y, 0, heuristic(start), null);

        pq.add(root);

        while (!pq.isEmpty()) {

            Node current = pq.poll();

            if (heuristic(current.state) == 0) {
                System.out.println("Solution Found:\n");
                printPath(current);
                return;
            }

            visited.add(matrixToString(current.state));

            for (int i = 0; i < 4; i++) {

                int newX = current.x + dx[i];
                int newY = current.y + dy[i];

                if (newX >= 0 && newX < 3 && newY >= 0 && newY < 3) {

                    int[][] newState = new int[3][3];

                    for (int r = 0; r < 3; r++) {
                        newState[r] = current.state[r].clone();
                    }

                    newState[current.x][current.y] = newState[newX][newY];
                    newState[newX][newY] = 0;

                    String key = matrixToString(newState);

                    if (!visited.contains(key)) {

                        Node child = new Node(
                                newState,
                                newX,
                                newY,
                                current.g + 1,
                                heuristic(newState),
                                current
                        );

                        pq.add(child);
                    }
                }
            }
        }

        System.out.println("No Solution Found");
    }

    public static void main(String[] args) {

        int[][] start = {
                {1, 2, 3},
                {4, 0, 6},
                {7, 5, 8}
        };

        solve(start, 1, 1);
    }
}
